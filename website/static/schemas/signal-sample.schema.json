{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalSample",
  "description": "One reading of one signal for one series at one instant.",
  "x-ess-name": "thalamus.observation.SignalSample",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "sample_id": {
      "$ref": "#/$defs/thalamus.observation.SampleId"
    },
    "signal": {
      "$ref": "#/$defs/thalamus.definition.SignalId",
      "x-ess-relation": {
        "name": "definition",
        "kind": "references",
        "source": "thalamus.observation.SignalSample",
        "target": "thalamus.definition.SignalDefinition",
        "cardinality": "one",
        "via": "signal"
      }
    },
    "series": {
      "$ref": "#/$defs/thalamus.observation.SeriesKey"
    },
    "dims": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/thalamus.dimension.DimensionValue"
      },
      "x-ess-map-key": "String"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "$ref": "#/$defs/thalamus.observation.TimeWindow"
    },
    "reading": {
      "$ref": "#/$defs/thalamus.observation.Reading"
    },
    "unit": {
      "$ref": "#/$defs/thalamus.definition.Unit"
    },
    "denominator": {
      "$ref": "#/$defs/thalamus.observation.Denominator"
    },
    "provenance": {
      "$ref": "#/$defs/thalamus.observation.Provenance"
    },
    "state": {
      "$ref": "#/$defs/thalamus.observation.SignalSample.State"
    }
  },
  "required": [
    "sample_id",
    "signal",
    "series",
    "dims",
    "ts",
    "window",
    "reading",
    "unit",
    "provenance",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "thalamus",
    "specification_version": "v1",
    "source_digest": "827e774bfdab74d78674ef1f90b801f077677fc03bc8c865ffa778e5b79217a0",
    "contract_digest": "slice-sha256/2:9010a011d477c52bc88dee2b6f56fe4e1cba14c2919a86bc4e5c8ec1ed4ce68f",
    "regenerate": "ess generate"
  },
  "$defs": {
    "thalamus.definition.AdapterId": {
      "title": "AdapterId",
      "description": "The source adapter that turns a connection operation into samples (sql, a metrics query, an orchestrator, version control, an HTTP probe, test-run events).",
      "x-ess-name": "thalamus.definition.AdapterId",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-alphabet": "abcdefghijklmnopqrstuvwxyz0123456789_"
    },
    "thalamus.definition.ConnectionId": {
      "title": "ConnectionId",
      "description": "A Connectors connection id. Thalamus holds no secret; the connection holds the credential.",
      "x-ess-name": "thalamus.definition.ConnectionId",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-alphabet": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.:/"
    },
    "thalamus.definition.SignalId": {
      "title": "SignalId",
      "description": "Stable signal id, spelled <family>.<layer>.<name> in lower case.",
      "x-ess-name": "thalamus.definition.SignalId",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-alphabet": "abcdefghijklmnopqrstuvwxyz0123456789_."
    },
    "thalamus.definition.Unit": {
      "title": "Unit",
      "description": "A UCUM unit, case-sensitive form (1, s, By, {request}, {pod}). A ratio has unit 1.",
      "x-ess-name": "thalamus.definition.Unit",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-alphabet": "!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    },
    "thalamus.dimension.DimensionValue": {
      "title": "DimensionValue",
      "description": "A value of one dimension key in one series.",
      "x-ess-name": "thalamus.dimension.DimensionValue",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "thalamus.observation.Bound": {
      "title": "Bound",
      "description": "Which side a partial reading's value bounds.",
      "x-ess-name": "thalamus.observation.Bound",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "lower",
        "upper"
      ]
    },
    "thalamus.observation.CompleteReading": {
      "title": "CompleteReading",
      "description": "Read completely.",
      "x-ess-name": "thalamus.observation.CompleteReading",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "thalamus.observation.Denominator": {
      "title": "Denominator",
      "description": "The population behind a ratio or count.",
      "x-ess-name": "thalamus.observation.Denominator",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "n": {
          "description": "The population the reading was taken over.",
          "type": "integer"
        },
        "unit": {
          "$ref": "#/$defs/thalamus.definition.Unit"
        },
        "since": {
          "description": "The earliest moment the population could contain anything.",
          "type": "string",
          "format": "date-time"
        },
        "age_s": {
          "description": "Seconds from since to the sample. A baseline whose offset exceeds it is UNKNOWN.",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "unit",
        "since",
        "age_s"
      ],
      "additionalProperties": false
    },
    "thalamus.observation.PartialReading": {
      "title": "PartialReading",
      "description": "Read but cut (a full page, a paged read that could not finish).",
      "x-ess-name": "thalamus.observation.PartialReading",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "value": {
          "description": "A bound on the true value, never the value itself.",
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "bound": {
          "$ref": "#/$defs/thalamus.observation.Bound"
        }
      },
      "required": [
        "value",
        "bound"
      ],
      "additionalProperties": false
    },
    "thalamus.observation.Provenance": {
      "title": "Provenance",
      "description": "Enough to re-run the read. Names a connection, never a credential.",
      "x-ess-name": "thalamus.observation.Provenance",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "producer": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "definition_rev": {
          "type": "integer"
        },
        "adapter": {
          "$ref": "#/$defs/thalamus.definition.AdapterId"
        },
        "connection": {
          "$ref": "#/$defs/thalamus.definition.ConnectionId"
        },
        "query_sha256": {
          "$ref": "#/$defs/thalamus.observation.QueryDigest"
        },
        "run_id": {
          "$ref": "#/$defs/thalamus.observation.RunId"
        }
      },
      "required": [
        "producer",
        "version",
        "definition_rev",
        "adapter",
        "connection",
        "query_sha256",
        "run_id"
      ],
      "additionalProperties": false
    },
    "thalamus.observation.QueryDigest": {
      "title": "QueryDigest",
      "description": "SHA-256 of the canonical JSON of the definition's query map (keys sorted, no whitespace), lower-case hex.",
      "x-ess-name": "thalamus.observation.QueryDigest",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-alphabet": "0123456789abcdef"
    },
    "thalamus.observation.Reading": {
      "title": "Reading",
      "description": "The value and its quality as one type. quality unknown has no value and a reason; partial has a value and its bound; ok has a value. The illegal pairs cannot be built.",
      "x-ess-name": "thalamus.observation.Reading",
      "x-ess-kind": "union",
      "oneOf": [
        {
          "title": "ok",
          "type": "object",
          "properties": {
            "quality": {
              "type": "string",
              "const": "ok"
            },
            "value": {
              "$ref": "#/$defs/thalamus.observation.CompleteReading"
            }
          },
          "required": [
            "quality",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "title": "partial",
          "type": "object",
          "properties": {
            "quality": {
              "type": "string",
              "const": "partial"
            },
            "value": {
              "$ref": "#/$defs/thalamus.observation.PartialReading"
            }
          },
          "required": [
            "quality",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "title": "unknown",
          "type": "object",
          "properties": {
            "quality": {
              "type": "string",
              "const": "unknown"
            },
            "value": {
              "$ref": "#/$defs/thalamus.observation.UnreadReading"
            }
          },
          "required": [
            "quality",
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "x-ess-union-tag": "quality"
    },
    "thalamus.observation.RunId": {
      "title": "RunId",
      "description": "Groups the samples of one sampling pass.",
      "x-ess-name": "thalamus.observation.RunId",
      "x-ess-kind": "newtype",
      "type": "string",
      "pattern": "^run_"
    },
    "thalamus.observation.SampleId": {
      "title": "SampleId",
      "description": "A sample id, minted by the producer.",
      "x-ess-name": "thalamus.observation.SampleId",
      "x-ess-kind": "newtype",
      "type": "string",
      "pattern": "^smp_"
    },
    "thalamus.observation.SeriesKey": {
      "title": "SeriesKey",
      "description": "One series, a signal id together with its dims values.",
      "x-ess-name": "thalamus.observation.SeriesKey",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "thalamus.observation.SignalSample.State": {
      "title": "State",
      "x-ess-name": "thalamus.observation.SignalSample.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Recorded"
      ]
    },
    "thalamus.observation.TimeWindow": {
      "title": "TimeWindow",
      "description": "The span a reading covers.",
      "x-ess-name": "thalamus.observation.TimeWindow",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "thalamus.observation.UnreadReading": {
      "title": "UnreadReading",
      "description": "Not read. Carries no value at all, so unknown can never become 0.",
      "x-ess-name": "thalamus.observation.UnreadReading",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
