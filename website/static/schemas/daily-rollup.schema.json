{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyRollup",
  "description": "One series over one UTC day; what remains once its samples leave raw retention (design § 4).",
  "x-ess-name": "thalamus.rollup.DailyRollup",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "rollup_id": {
      "$ref": "#/$defs/thalamus.rollup.RollupId"
    },
    "signal": {
      "$ref": "#/$defs/thalamus.definition.SignalId",
      "x-ess-relation": {
        "name": "definition",
        "kind": "references",
        "source": "thalamus.rollup.DailyRollup",
        "target": "thalamus.definition.SignalDefinition",
        "cardinality": "one",
        "via": "signal"
      }
    },
    "series": {
      "$ref": "#/$defs/thalamus.observation.SeriesKey"
    },
    "day": {
      "description": "The UTC midnight the day starts at.",
      "type": "string",
      "format": "date-time"
    },
    "n": {
      "description": "The samples of the day.",
      "type": "integer"
    },
    "unknown": {
      "description": "The samples of quality unknown.",
      "type": "integer"
    },
    "partial": {
      "description": "The samples of quality partial.",
      "type": "integer"
    },
    "min": {
      "description": "Over the day's ok readings; absent when the day has none, never 0.",
      "type": "string",
      "format": "decimal",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "p50": {
      "description": "Over the day's ok readings; absent when the day has none, never 0.",
      "type": "string",
      "format": "decimal",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "max": {
      "description": "Over the day's ok readings; absent when the day has none, never 0.",
      "type": "string",
      "format": "decimal",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "last": {
      "description": "The last ok reading of the day; absent when the day has none, never 0.",
      "type": "string",
      "format": "decimal",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "worst_verdict": {
      "$ref": "#/$defs/thalamus.evaluation.Verdict",
      "description": "The worst verdict of the day by the ladder's rank; absent when the day has no evaluation."
    },
    "verdict_counts": {
      "$ref": "#/$defs/thalamus.rollup.VerdictCounts"
    },
    "min_score": {
      "description": "Over the day's scored evaluations; absent when none carries a score, never 0.",
      "type": "string",
      "format": "decimal",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "max_score": {
      "description": "Over the day's scored evaluations; absent when none carries a score, never 0.",
      "type": "string",
      "format": "decimal",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "state": {
      "$ref": "#/$defs/thalamus.rollup.DailyRollup.State"
    }
  },
  "required": [
    "rollup_id",
    "signal",
    "series",
    "day",
    "n",
    "unknown",
    "partial",
    "verdict_counts",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "thalamus",
    "specification_version": "v1",
    "source_digest": "99b2e1b31aebb3cdde7af7bb46be2ec80e4af2ccd183cd598985f3a30326c48f",
    "contract_digest": "slice-sha256/2:8e91ddb4745f12892bca7fcd34cf32f15cb414040e1f1dbde912aaa85b8abbe8",
    "regenerate": "ess generate"
  },
  "$defs": {
