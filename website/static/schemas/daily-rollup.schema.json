      "x-ess-name": "thalamus.evaluation.Verdict",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "OK",
        "N/A",
        "WARN",
        "CRIT",
        "UNKNOWN"
      ],
      "x-ess-attributes": [
        {
          "kind": "integer",
          "name": "exit",
          "type": "Integer",
          "values": {
            "CRIT": 2,
            "N/A": 0,
            "OK": 0,
            "UNKNOWN": 3,
            "WARN": 1
          }
        },
        {
          "kind": "integer",
          "name": "rank",
          "type": "Integer",
          "values": {
            "CRIT": 3,
            "N/A": 0,
            "OK": 0,
            "UNKNOWN": 1,
            "WARN": 2
          }
        },
        {
          "kind": "boolean",
          "name": "scored",
          "type": "Boolean",
          "values": {
            "CRIT": true,
            "N/A": false,
            "OK": true,
            "UNKNOWN": false,
            "WARN": true
          }
        }
      ]
    },
    "thalamus.observation.SeriesKey": {
      "title": "SeriesKey",
      "description": "One series, a signal id together with its dims values.",
      "x-ess-name": "thalamus.observation.SeriesKey",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "thalamus.rollup.DailyRollup.State": {
      "title": "State",
      "x-ess-name": "thalamus.rollup.DailyRollup.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Recorded"
      ]
    },
    "thalamus.rollup.RollupId": {
      "title": "RollupId",
      "description": "A rollup id, spelled from the series key and the UTC day.",
      "x-ess-name": "thalamus.rollup.RollupId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "thalamus.rollup.VerdictCounts": {
      "title": "VerdictCounts",
      "description": "One count per verdict of the ladder, over the day's evaluations.",
      "x-ess-name": "thalamus.rollup.VerdictCounts",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "ok": {
          "type": "integer"
        },
        "na": {
          "description": "The N/A verdicts.",
          "type": "integer"
        },
        "warn": {
          "type": "integer"
        },
        "crit": {
          "type": "integer"
        },
        "unknown": {
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "na",
        "warn",
        "crit",
        "unknown"
      ],
      "additionalProperties": false
    }
  }
